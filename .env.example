# URAI staging environment checklist
# Do not commit real secret values. Keep this file as names-only documentation.

# Canonical Firebase / Google Cloud staging separation.
URAI_STAGING_PROJECT_ID=urai-staging
URAI_STAGING_URL=https://urai-staging.web.app
URAI_PRODUCTION_DEPLOY_APPROVED=0

# Must remain 0 in local environments. The protected workflow sets 1 only inside its credentialed deploy job.
URAI_STAGING_PROTECTED_DEPLOY=0

# Local Firebase/GCP project binding for staging-only non-deploy tools.
GOOGLE_CLOUD_PROJECT=urai-staging
GCLOUD_PROJECT=urai-staging

# Release evidence
URAI_RELEASE_CANDIDATE_SHA=
URAI_ROLLBACK_TARGET_SHA=
URAI_DEPLOYED_AT=
URAI_STAGING_SMOKE_TESTED=0

# Firebase Admin / local credentials
# Use emulator or local-only credentials for tests. Never place the protected staging service account here.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_TOKEN=

# OpenAI / AI providers
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# Render / Python backend
RENDER_API_KEY=
RENDER_SERVICE_ID=
PYTHON_BACKEND_URL=

# Gmail / Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_SCOPES=

# Stripe / payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Analytics
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=
GA_MEASUREMENT_ID=

# Storage / CDN
FIREBASE_STORAGE_BUCKET=
CDN_BASE_URL=

# Notifications / SMS / email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# Production project identifiers and production credentials must not be present in staging environment files or used by staging deploy scripts.
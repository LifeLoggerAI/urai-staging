{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "vitest run test/auth.test.ts test/validation.test.ts test/featureRegistry.test.ts test/stagingBoundaries.test.ts",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore \"vitest run test/firestore.rules.test.ts\"",
    "test:e2e": "npm run test:rules"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "firebase": "12.7.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "firebase-tools": {
      "chokidar": "4.0.3"
    },
    "@fastify/busboy": "3.2.2",
    "proxy-addr": "2.0.8",
    "basic-ftp": "6.2.1",
    "qs": "6.16.0",
    "ip-address": "10.7.1",
    "fast-uri": "3.1.8",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "@grpc/grpc-js": "1.14.5",
    "body-parser@1": "1.20.6",
    "protobufjs": "7.6.5",
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "uuid@8": "11.1.1",
    "uuid@9": "11.1.1",
    "@opentelemetry/core": "2.8.0"
  }
}
